{
  "name": "mergeabot-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-merge PRs based on config, only after quarantine days",
  "main": "lib/main.js",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "tsc && ncc build lib/main.js --minify --out dist",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "knip": "knip",
    "readme": "action-docs -u README.md && prettier --write README.md",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/mergeabot-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^6.0.0",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.45.0",
    "action-docs": "^2.5.1",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
