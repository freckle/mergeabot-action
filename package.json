{
  "name": "mergeabot-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-merge PRs based on config, only after quarantine days",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "prettier": "@freckle/prettier-config",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/main.js --minify --out dist",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "knip": "knip",
    "lint": "eslint",
    "readme": "action-docs -u README.md && prettier --write README.md",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/mergeabot-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^6.0.1",
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.2",
    "@freckle/prettier-config": "^1.3.1",
    "@freckle/tsconfig": "^1.3.2",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.3",
    "action-docs": "^2.5.1",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
