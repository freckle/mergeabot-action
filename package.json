{
  "name": "mergeabot-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-merge PRs based on config, only after quarantine days",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "prettier": "@freckle/prettier-config",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/main.js --minify --out dist",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "knip": "knip",
    "lint": "eslint",
    "readme": "action-docs -u README.md && prettier --write README.md",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/mergeabot-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^6.0.1",
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.4",
    "@freckle/prettier-config": "^1.3.3",
    "@freckle/tsconfig": "^1.3.4",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "action-docs": "^2.5.1",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
