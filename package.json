{
  "name": "mergeabot-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-merge PRs based on config, only after quarantine days",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "prettier": "@freckle/prettier-config",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/main.js --minify --out dist",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "knip": "knip",
    "lint": "eslint",
    "readme": "action-docs -u README.md && prettier --write README.md",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/mergeabot-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^6.0.1",
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.2.0",
    "@freckle/prettier-config": "^1.2.0",
    "@freckle/tsconfig": "^1.2.0",
    "@types/node": "^24.19.1",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.3",
    "action-docs": "^2.5.1",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
