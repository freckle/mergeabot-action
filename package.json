{
  "name": "mergeabot-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-merge PRs based on config, only after quarantine days",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/main.js --minify --out dist",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "knip": "knip",
    "lint": "eslint",
    "readme": "action-docs -u README.md && prettier --write README.md",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/mergeabot-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^6.0.0",
    "ignore": "^7.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "action-docs": "^2.5.1",
    "eslint": "^10.10.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
